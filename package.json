{
  "name": "ride-sharing-service",
  "version": "1.0.0",
  "description": "Backend service for a ride-sharing platform",
  "main": "src/server.ts",
  "author": "talha habib <m.talhahabib98@gmail.com>",
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "start": "node ./dist/server.js",
    "dev": "ts-node ./src/server.ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "lint": "eslint \"src/**/*.ts\"",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^5.1.1",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "pino": "^8.14.2",
    "pino-http": "^8.5.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/node": "^20.2.5",
    "@typescript-eslint/eslint-plugin": "^5.61.0",
    "@typescript-eslint/parser": "^5.61.0",
    "eslint": "^8.44.0",
    "eslint-config-prettier": "^8.8.0",
    "pino-pretty": "^10.2.0",
    "prettier": "^2.8.8",
    "prisma": "^5.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.3"
  }
}
