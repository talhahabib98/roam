generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  RIDER
  DRIVER
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  driver       Driver?
  rides        Ride[]
}

enum DriverStatus {
  OFFLINE
  ONLINE
  BUSY
}

model Driver {
  id                String       @id @default(uuid())
  userId            String       @unique
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleModel      String
  vehiclePlate      String
  status            DriverStatus @default(OFFLINE)
  latitude          Float?
  longitude         Float?
  locationUpdatedAt DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  rides             Ride[]
}

enum RideStatus {
  REQUESTED
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Ride {
  id          String     @id @default(uuid())
  riderId     String
  rider       User       @relation(fields: [riderId], references: [id])
  driverId    String?
  driver      Driver?    @relation(fields: [driverId], references: [id])
  status      RideStatus @default(REQUESTED)
  pickupLat   Float
  pickupLng   Float
  dropoffLat  Float
  dropoffLng  Float
  distanceKm  Float
  fareCents   Int
  requestedAt DateTime   @default(now())
  acceptedAt  DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  cancelledAt DateTime?
  updatedAt   DateTime   @updatedAt

  @@index([riderId])
  @@index([driverId])
}
